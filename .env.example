# 공공데이터포털(data.go.kr) 설정 — 이 파일을 .env.local 로 복사한 뒤 인증키를 입력하세요.
# 필요한 API 활용신청: 금융위원회_주식시세정보, 금융위원회_주식배당정보

# 금융위원회_주식시세정보 (GetStockSecuritiesInfoService_V2)
DATA_GO_KR_ENDPOINT=https://apis.data.go.kr/1160100/GetStockSecuritiesInfoService_V2

# 일반 인증키 (디코딩 키)
DATA_GO_KR_SERVICE_KEY=

# (선택) 금융위원회_주식배당정보 — 생략 시 기본값 사용
# DATA_GO_KR_DIVI_ENDPOINT=https://apis.data.go.kr/1160100/GetStocDiviInfoService_V2
